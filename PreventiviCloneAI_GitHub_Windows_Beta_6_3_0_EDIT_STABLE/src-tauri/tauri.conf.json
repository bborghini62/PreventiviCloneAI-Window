{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Preventivi Clone AI",
  "version": "1.0.0-beta.6.3.0",
  "identifier": "it.preventivicloneai.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Preventivi Clone AI",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Importa e modifica computi e preventivi PDF",
    "longDescription": "Preventivi Clone AI riconosce computi e preventivi PDF e li trasforma in documenti editabili con prezzi, sconti, sottovoci e stampa.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
